# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database (MySQL 8.0) ─────────────────────────────────
# DB_HOST=db          -> use the docker-compose service name when running in Docker
# DB_HOST=127.0.0.1   -> use this when running the API directly on the host
DB_HOST=db
DB_PORT=3306
DB_NAME=parkwatch
DB_USER=parkwatch_user
DB_PASSWORD=change_me_in_dev
# Required by docker-compose (no fallback). Used only on first DB container init.
MYSQL_ROOT_PASSWORD=change_me_to_a_strong_root_password

# ─── JSON Web Tokens ──────────────────────────────────────
# Generate your own: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ─── Google Cloud Vision API (OCR) ────────────────────────
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
# Path to the GCP service-account key (gitignored; used by Vision + Storage)
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# ─── Google Cloud Storage (evidence photos) ──────────────
GCS_BUCKET_NAME=parkwatch-evidence-capstone
# Optional: a known plate image for scripts/test-ocr.js connectivity check.
TEST_PLATE_IMAGE_URI=gs://your-bucket/test-plate.jpg

# ─── Firebase Cloud Messaging (push notifications) ───────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── ParkWatch Business Rules ─────────────────────────────
# Minimum OCR confidence (%) to auto-accept a plate; below this requires manual review.
OCR_CONFIDENCE_THRESHOLD=70
# Window (minutes) used to flag duplicate reports of the same plate/location.
DUPLICATE_DETECTION_WINDOW_MINUTES=60
# Escalation timer (UC-10, src/jobs/escalationJob.js):
#   RESPONSE window — minutes a verified report waits before MTPB officers are
#     re-notified.
#   RENOTIFY window — minutes after re-notification before it escalates to a
#     supervisor.
MTPB_RESPONSE_WINDOW_MINUTES=60
MTPB_RENOTIFY_WINDOW_MINUTES=15
# Legacy name (still read as a fallback for MTPB_RESPONSE_WINDOW_MINUTES).
MTPB_RESPONSE_TIMER_MINUTES=30

# ─── Optional: API tuning (sensible defaults applied in code) ─
# Comma-separated allowed origins, used only when NODE_ENV=production.
# CORS_ORIGINS=https://app.parkwatch.example
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
# Auth brute-force throttle (login/register) — runs in all environments.
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=20
# LOG_LEVEL=debug
