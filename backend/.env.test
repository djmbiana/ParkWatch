# Test-only environment. Loaded by jest.setup.js (override: true) so the unit
# tests run against deterministic values regardless of the container's runtime
# .env. Contains NO secrets — all values are dummy fixtures.
#
# GCS_BUCKET_NAME must match the bucket in tests/ocrService.test.js fixtures
# (test-bucket) so storageService.parsePhotoRef accepts the fixture photo URLs.
GCS_BUCKET_NAME=test-bucket
NODE_ENV=test
OCR_CONFIDENCE_THRESHOLD=70
DUPLICATE_WINDOW_MINUTES=30
MTPB_RESPONSE_WINDOW_MINUTES=60
MTPB_RENOTIFY_WINDOW_MINUTES=15
