# ParkWatch frontend env. Copy to .env and fill in.

# Base URL of the ParkWatch API. Leave blank to use same-origin (dev proxy).
VITE_API_URL=

# --- Optional: FCM push notifications for the citizen app (UC-03) ---
# Push registration stays disabled until ALL of these are set (src/services/fcm.js
# no-ops otherwise). Values come from your Firebase project's web app config.
# Also mirror these into public/firebase-messaging-sw.js (service workers can't
# read VITE_* env).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FCM_VAPID_KEY=
