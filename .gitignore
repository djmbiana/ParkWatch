# ─── Dependencies ─────────────────────────────────────────
node_modules/

# ─── Environment Variables ────────────────────────────────
# NEVER commit real credentials — use .env.example instead
.env
.env.local
.env.*.local

# ─── Secret Keys (GCP + Firebase service account JSONs) ───
# Explicit filenames required by spec (kebab-case doesn't match camelCase globs)
gcp-service-account.json
firebase-service-account.json
backend/config/gcloud-key.json
backend/config/firebase-key.json
*.key.json
*-key.json
*-credentials.json
*serviceAccount*.json
*-service-account.json

# ─── Uploaded Files (local dev only, goes to GCS in prod) ─
# Ignore contents but track the directory so it exists after clone.
backend/uploads/*
!backend/uploads/.gitkeep

# ─── Logs ─────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ─── Build Output ─────────────────────────────────────────
dist/
build/
.vite/

# ─── OS Files ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDEs ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Docker ───────────────────────────────────────────────
# Keep docker-compose.yml but ignore local override files with passwords
docker-compose.override.yml

# ─── MySQL local data volume (if running without Docker) ──
mysql_data/

# ─── UAT survey drafts (not part of the codebase) ─────────
UAT-SURVEY-QUESTIONS.md

# ─── Thesis working docs (not part of the codebase) ──────
THESIS-CONTEXT.md

# ─── Working documentation (not part of the codebase) ─────
# docs/TESTING.md, docs/credentials.md, and docs/postman/ are already
# tracked from before this rule — this only stops NEW files in these
# folders (audit notes, defense prep, generated reports, etc.) from being
# picked up. Untrack an already-committed file explicitly if you want it
# removed too (git rm --cached <path>).
docs/
frontend/docs/
