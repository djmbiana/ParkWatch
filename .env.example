# Root .env.example — used by docker-compose for ${VAR} substitution.
# Copy this file to .env (same directory) before running docker-compose up.
# This file is safe to commit; .env is gitignored.
#
# The backend container has its own config at ./backend/.env.example.
# For standalone local dev (no Docker), copy that file to ./backend/.env.

# ─── MySQL (docker-compose db service) ────────────────────
DB_NAME=parkwatch
DB_USER=parkwatch_user
DB_PASSWORD=change_me_in_dev

# Root password for the MySQL container (separate from the app-user password).
MYSQL_ROOT_PASSWORD=change_me_root
