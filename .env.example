# Root .env — used by docker-compose for ${VAR} substitution in docker-compose.yml.
# Copy to .env in this same directory and fill in real values.
# These values MUST match backend/.env so the backend authenticates to MySQL correctly.

DB_NAME=parkwatch
DB_USER=parkwatch_user
DB_PASSWORD=parkwatch_pass
MYSQL_ROOT_PASSWORD=root_pass_change_me